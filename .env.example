# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ALGORAND TESTNET CONFIGURATION
ALGOD_SERVER="https://testnet-api.4160.nodely.dev"
ALGOD_PORT=""
ALGOD_TOKEN=""
INDEXER_SERVER="https://testnet-idx.4160.nodely.dev"

# GOPLAUSIBLE / x402 FACILITATOR
X402_FACILITATOR_URL="https://facilitator.goplausible.xyz"
X402_NETWORK="algorand-testnet"

# AUTOSHIELD ESCROW & CREATOR ACCOUNT (25-word Algorand Testnet mnemonic, optional - auto-generated if blank)
AUTOSHIELD_CREATOR_MNEMONIC=""

